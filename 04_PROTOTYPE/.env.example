# Copy this file to .env and fill in values if you want a real LLM backend.
# Neither is required -- with no Ollama server and no API key, the
# deterministic rule-based provider drives the demo automatically.

# Option 1: local Ollama server (checked first)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Option 2: Anthropic API fallback (checked second, only if Ollama is unreachable)
ANTHROPIC_API_KEY=
